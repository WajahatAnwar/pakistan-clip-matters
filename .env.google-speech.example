# =====================================================
# Google Cloud Speech-to-Text Configuration
# =====================================================

# Your Google Cloud Project ID
# Find this in: https://console.cloud.google.com/ -> Project Settings
GOOGLE_CLOUD_PROJECT_ID=your-project-id-here

# Google Cloud Location/Region
# Options: global, us-central1, europe-west1, asia-east1, etc.
# Use 'global' for worldwide access
GOOGLE_CLOUD_LOCATION=global

# Path to your Google Cloud Service Account JSON key file
# Download from: Google Cloud Console -> IAM & Admin -> Service Accounts
# Make sure the service account has "Cloud Speech-to-Text API" permissions
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Example for production:
# GOOGLE_APPLICATION_CREDENTIALS=/var/www/html/credentials/google-speech-sa.json

# Example for local development:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/yourname/projects/myapp/credentials/speech-key.json

# =====================================================
# Optional: Google Cloud Storage (for batch processing)
# =====================================================

# GCS Bucket name for storing audio files
GOOGLE_CLOUD_STORAGE_BUCKET=your-audio-bucket

# GCS Bucket for transcription outputs
GOOGLE_CLOUD_TRANSCRIPTION_BUCKET=your-transcriptions-bucket

# =====================================================
# Setup Instructions
# =====================================================

# 1. Enable the Cloud Speech-to-Text API
#    - Go to: https://console.cloud.google.com/apis/library/speech.googleapis.com
#    - Click "Enable"

# 2. Create a Service Account
#    - Go to: https://console.cloud.google.com/iam-admin/serviceaccounts
#    - Click "Create Service Account"
#    - Give it a name (e.g., "speech-to-text-service")
#    - Grant role: "Cloud Speech-to-Text Client" or "Cloud Speech Administrator"
#    - Click "Done"

# 3. Create and Download Key
#    - Click on the service account you just created
#    - Go to "Keys" tab
#    - Click "Add Key" -> "Create new key"
#    - Choose "JSON" format
#    - Download and save the file securely
#    - Set GOOGLE_APPLICATION_CREDENTIALS to the file path

# 4. Set Up Billing
#    - Google Cloud Speech requires a billing account
#    - Go to: https://console.cloud.google.com/billing

# 5. Test Your Setup
#    Run: php artisan tinker
#    Then: $service = new \App\Services\GoogleCloudSpeechService();
#          $service->transcribe('path/to/audio.wav', 'en-US');
