# Copy these settings into the deployment environment. No real secrets belong here.
EMBEDDING_SERVICE_URL=https://your-python-service.example
# Same value as API_KEY in the Python API and RQ worker.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_SEARCH_TIMEOUT=120
# Optional override; defaults to APP_URL + /api/embeddings/callback.
EMBEDDING_CALLBACK_URL=https://your-laravel-app.example/api/embeddings/callback
